[
  {
    "path": "/api/auth/login",
    "methods": [
      "POST"
    ],
    "auth": "public",
    "permission": "auth.login",
    "request": {
      "password": "string"
    },
    "response": {
      "status": "success|error",
      "message": "string",
      "token": "string (仅成功时, 64 位 hex)"
    },
    "notes": "登录入口, 协议上必须免认证. 旧版密码错误返回 401 且 body 为 status=error / message=密码错误. Rust 侧须补登录失败限速、Token 过期/撤销/轮换, 且避免把长期凭证写入 localStorage."
  },
  {
    "path": "/api/auth/status",
    "methods": [
      "GET"
    ],
    "auth": "public",
    "permission": "auth.status.read",
    "request": {},
    "response": {
      "logged_in": "bool",
      "auth_required": "bool"
    },
    "notes": "登录状态查询, 公开. 带 Bearer Token 时返回该 Token 是否有效. 不返回任何 Token 内容."
  },
  {
    "path": "/api/auth/logout",
